<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tells browsers to keep the files in assets/ (images, CSS, JavaScript, videos)
  for 7 days instead of asking the server again on every page. CSS and
  JavaScript changes still show right away, because their addresses change
  whenever the file does (asset_url() in includes/config.php). A photo
  replaced under the same filename can take up to 7 days to show for recent
  visitors. Only the cache setting lives here: the .webp file type is
  registered in the main web.config, and adding it here too would break every
  image. To undo, delete this file.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
