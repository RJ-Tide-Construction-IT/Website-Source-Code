<?xml version="1.0" encoding="UTF-8"?>
<!--
  Safety Data Sheets are replaced under the same filename, so browsers must
  check for a newer copy every time instead of keeping one for 7 days (see
  assets/web.config). Unchanged sheets still load quickly from the browser's
  copy. To undo, delete this file.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
