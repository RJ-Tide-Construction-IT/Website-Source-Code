<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS equivalent of .htaccess (Apache isn't used on this host). Mirrors the
  same protections: security headers, no directory listings, and blocking
  direct access to includes/ and uploads/ (PHP still reads them fine via
  require()/file_put_contents(), those are server-side filesystem calls,
  not HTTP requests, so hiding the folder from IIS doesn't affect them),
  plus any dot-prefixed path (.git, .env, .gitignore, etc.).

  Uses only core IIS request filtering, no optional modules (like URL
  Rewrite) that may not be installed on this shared hosting plan, so this
  can't break the site with a "module not found" config error.
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!-- The parent site's own web.config (DotNetNuke) already defines
             some of these, IIS won't let a child config add a duplicate
             entry to the same collection (that's what caused the 500.19
             error), so clear first and redefine cleanly for this folder. -->
        <clear />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Tells browsers to only ever use https for this site for the next
             year. Deliberately without includeSubDomains, so other rjtide.com
             subdomains (email, etc.) aren't affected. The SSL certificate
             must stay valid for rjtide.com and www.rjtide.com, or visitors
             can't get in at all until it's fixed. -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>

    <!-- Our own "Page Not Found" page (404.php) instead of the server's
         default one. The remove-then-add avoids a duplicate-entry 500.19
         error if the parent site's config already sets a 404 page. -->
    <httpErrors existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" prefixLanguageFilePath="" path="/404.php" responseMode="ExecuteURL" />
    </httpErrors>

    <directoryBrowse enabled="false" />

    <!-- Site photos are .webp. Older IIS versions don't know that file type
         and refuse to serve it, so register it here (remove first, in case
         the server already has it, to avoid a duplicate-entry error). -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <security>
      <requestFiltering>
        <!-- IIS hides some segments by default (web.config, bin, App_Data,
             etc.), clearing the collection below removes those defaults
             too, so re-add web.config explicitly alongside the folders
             PHP require()'s internally but a visitor should never fetch
             directly: config.php, secrets.php, mailer.php in includes/;
             resumes and the applications log in uploads/. -->
        <hiddenSegments>
          <clear />
          <add segment="web.config" />
          <add segment="includes" />
          <add segment="uploads" />
        </hiddenSegments>

        <!-- Blocks any URL with a dot-prefixed path segment, /.git/,
             /.env, /.gitignore, etc., even with directory listing off. -->
        <denyUrlSequences>
          <clear />
          <add sequence="/." />
        </denyUrlSequences>

        <!-- Migration scratch scripts/docs, never needed by visitors. -->
        <fileExtensions allowUnlisted="true">
          <clear />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
