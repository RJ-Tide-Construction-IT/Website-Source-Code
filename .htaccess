# Site-wide baseline hardening.

Options -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

ErrorDocument 404 /404.php

# Migration scratch data / scripts / docs, never needed by visitors.
<FilesMatch "\.(ps1|md)$">
    Require all denied
</FilesMatch>

# Block VCS metadata and dotfiles in case this folder (which is now a git repo)
# is ever uploaded to a live host with hidden files included, .git/config,
# .git/HEAD, etc. would otherwise be directly fetchable and let an attacker
# reconstruct the full source tree, even with directory listing off.
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git(/|$)
</IfModule>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
